{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start portfolio server",
            "type": "process",
            "command": "python",
            "args": ["-u", "-m", "http.server", "8080", "--bind", "127.0.0.1"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "portfolio-preview",
                "pattern": {
                    "regexp": "^(.+):(\\d+): (.+)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Serving HTTP",
                    "endsPattern": "^Serving HTTP on 127\\.0\\.0\\.1 port 8080"
                }
            }
        }
    ]
}
